set(lwip_vendor_root "${PROJECT_SOURCE_DIR}/vendor/lwip")
file(READ "${PROJECT_SOURCE_DIR}/vendor/lwip-manifest.json" lwip_manifest)
string(JSON lwip_commit GET "${lwip_manifest}" commit)
if(NOT lwip_commit STREQUAL "77dcd25a72509eb83f72b033d219b1d40cd8eb95")
  message(FATAL_ERROR "Unexpected lwIP source commit")
endif()
string(JSON lwip_count LENGTH "${lwip_manifest}" files)
math(EXPR lwip_last "${lwip_count} - 1")
foreach(lwip_index RANGE ${lwip_last})
  string(JSON lwip_path MEMBER "${lwip_manifest}" files ${lwip_index})
  string(JSON lwip_expected GET "${lwip_manifest}" files "${lwip_path}")
  if(IS_ABSOLUTE "${lwip_path}" OR lwip_path MATCHES "(^|/)\\.\\.(/|$)")
    message(FATAL_ERROR "Invalid lwIP vendor path: ${lwip_path}")
  endif()
  file(SHA256 "${lwip_vendor_root}/${lwip_path}" lwip_observed)
  if(NOT lwip_observed STREQUAL lwip_expected)
    message(FATAL_ERROR "lwIP vendor source hash mismatch: ${lwip_path}")
  endif()
endforeach()
