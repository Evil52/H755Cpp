set(CMAKE_SYSTEM_NAME Generic)
set(CMAKE_SYSTEM_PROCESSOR arm)
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY)

if(DEFINED ENV{H755_ARM_TOOLCHAIN})
  file(TO_CMAKE_PATH "$ENV{H755_ARM_TOOLCHAIN}" H755_ARM_TOOLCHAIN)
else()
  get_filename_component(H755_ARM_TOOLCHAIN "${CMAKE_CURRENT_LIST_DIR}/../../.tools/arm-gcc-16.2.0-cm7" ABSOLUTE)
endif()

foreach(tool gcc g++ ar ranlib objcopy size)
  if(NOT EXISTS "${H755_ARM_TOOLCHAIN}/bin/arm-none-eabi-${tool}")
    message(FATAL_ERROR "Missing ${tool} in ${H755_ARM_TOOLCHAIN}; GCC 16.2 CM7 toolchain must be installed first")
  endif()
endforeach()

set(CMAKE_C_COMPILER "${H755_ARM_TOOLCHAIN}/bin/arm-none-eabi-gcc")
set(CMAKE_CXX_COMPILER "${H755_ARM_TOOLCHAIN}/bin/arm-none-eabi-g++")
set(CMAKE_ASM_COMPILER "${CMAKE_C_COMPILER}")
set(CMAKE_AR "${H755_ARM_TOOLCHAIN}/bin/arm-none-eabi-ar")
set(CMAKE_RANLIB "${H755_ARM_TOOLCHAIN}/bin/arm-none-eabi-ranlib")
set(CMAKE_OBJCOPY "${H755_ARM_TOOLCHAIN}/bin/arm-none-eabi-objcopy")
set(CMAKE_SIZE "${H755_ARM_TOOLCHAIN}/bin/arm-none-eabi-size")
set(CMAKE_FIND_ROOT_PATH "${H755_ARM_TOOLCHAIN}/arm-none-eabi")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
