if(NOT DEFINED H755_USB_VENDOR_ROOT)
  set(H755_USB_VENDOR_ROOT "${CMAKE_CURRENT_LIST_DIR}/../vendor")
endif()
file(READ "${H755_USB_VENDOR_ROOT}/usb-async-manifest.json" usb_manifest)
string(JSON package_count LENGTH "${usb_manifest}")
math(EXPR package_last "${package_count} - 1")
foreach(package_index RANGE ${package_last})
  string(JSON package_path GET "${usb_manifest}" ${package_index} path)
  string(JSON file_count LENGTH "${usb_manifest}" ${package_index} files)
  math(EXPR file_last "${file_count} - 1")
  foreach(file_index RANGE ${file_last})
    string(JSON source GET "${usb_manifest}" ${package_index} files ${file_index} path)
    string(JSON expected GET "${usb_manifest}" ${package_index} files ${file_index} sha256)
    string(JSON patched ERROR_VARIABLE no_patch GET "${usb_manifest}" ${package_index} patched_files "${source}")
    if(NOT no_patch)
      set(expected "${patched}")
    endif()
    set(relative "${package_path}/${source}")
    if(IS_ABSOLUTE "${relative}" OR relative MATCHES "(^|/)\\.\\.(/|$)")
      message(FATAL_ERROR "Invalid vendor path: ${relative}")
    endif()
    file(SHA256 "${H755_USB_VENDOR_ROOT}/${relative}" observed)
    if(NOT observed STREQUAL expected)
      message(FATAL_ERROR "USB vendor source hash mismatch: ${relative}")
    endif()
  endforeach()
endforeach()
