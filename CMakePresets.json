{
  "version": 6,
  "cmakeMinimumRequired": {"major": 3, "minor": 30, "patch": 0},
  "configurePresets": [
    {
      "name": "host-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/host-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "H755_HOST_SANITIZERS": "ON"
      }
    },
    {
      "name": "host-coverage",
      "inherits": "host-debug",
      "binaryDir": "${sourceDir}/build/host-coverage",
      "cacheVariables": {"H755_HOST_COVERAGE": "ON"}
    },
    {
      "name": "cm7-debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/cm7-debug",
      "toolchainFile": "${sourceDir}/cmake/toolchains/arm-gcc16.cmake",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Debug"}
    },
    {
      "name": "cm7-release",
      "inherits": "cm7-debug",
      "binaryDir": "${sourceDir}/build/cm7-release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release"}
    }
  ],
  "buildPresets": [
    {"name": "host-debug", "configurePreset": "host-debug"},
    {"name": "host-coverage", "configurePreset": "host-coverage"},
    {"name": "cm7-debug", "configurePreset": "cm7-debug"},
    {"name": "cm7-release", "configurePreset": "cm7-release"}
  ],
  "testPresets": [
    {"name": "host-debug", "configurePreset": "host-debug", "output": {"outputOnFailure": true}}
  ]
}
